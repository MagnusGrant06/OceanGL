# Cube - 24 vertices (4 per face, for flat per-face normals)
# v/vt/vn format - vt is a dummy value (parser doesn't use it, but needs the slot present)

vt 0.0 0.0

# Front face (+Z)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0

# Back face (-Z)
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5
vn 0.0 0.0 -1.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 -1.0

# Left face (-X)
v -0.5 -0.5 -0.5
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -0.5  0.5 -0.5
vn -1.0 0.0 0.0
vn -1.0 0.0 0.0
vn -1.0 0.0 0.0
vn -1.0 0.0 0.0

# Right face (+X)
v 0.5 -0.5  0.5
v 0.5 -0.5 -0.5
v 0.5  0.5 -0.5
v 0.5  0.5  0.5
vn 1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 1.0 0.0 0.0

# Top face (+Y)
v -0.5 0.5  0.5
v  0.5 0.5  0.5
v  0.5 0.5 -0.5
v -0.5 0.5 -0.5
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0

# Bottom face (-Y)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5
v -0.5 -0.5  0.5
vn 0.0 -1.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 -1.0 0.0

# Faces (v/vt/vn), 1-indexed, two triangles per side
f 1/1/1 2/1/2 3/1/3
f 1/1/1 3/1/3 4/1/4

f 5/1/5 6/1/6 7/1/7
f 5/1/5 7/1/7 8/1/8

f 9/1/9 10/1/10 11/1/11
f 9/1/9 11/1/11 12/1/12

f 13/1/13 14/1/14 15/1/15
f 13/1/13 15/1/15 16/1/16

f 17/1/17 18/1/18 19/1/19
f 17/1/17 19/1/19 20/1/20

f 21/1/21 22/1/22 23/1/23
f 21/1/21 23/1/23 24/1/24
